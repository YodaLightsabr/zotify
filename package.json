{
  "name": "rb",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/server.js",
    "typecheck": "tsc --noEmit",
    "queue-songs": "tsx --env-file-if-exists=.env src/scripts/queue-songs.ts",
    "example": "tsx --env-file-if-exists=.env src/scripts/example.ts",
    "backup": "node --disable-warning=ExperimentalWarning dist/scripts/backup.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
