{
  "name": "rb",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "dev:web": "next dev web --port 3000",
    "build": "tsc && next build web",
    "build:api": "tsc",
    "build:web": "next build web",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/server.js",
    "start:web": "next start web --port 3000",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "queue-songs": "tsx --env-file-if-exists=.env src/scripts/queue-songs.ts",
    "example": "tsx --env-file-if-exists=.env src/scripts/example.ts",
    "backup": "node --disable-warning=ExperimentalWarning dist/scripts/backup.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.32.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
