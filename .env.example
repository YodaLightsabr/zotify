# Copy these into .env (which is gitignored) and fill them in.

# Resend API key for emailing login codes. Without it, codes are printed to the server console.
RESEND_API_KEY=re_xxxxxxxxx

# Optional: who login emails come from. Defaults to Zotify <hello@zotify.app>, on our verified domain.
# RESEND_FROM=Zotify <hello@zotify.app>

# A Spotify app (developer.spotify.com/dashboard), so people can connect Spotify to import their library and open private
# playlists. Its redirect URI must be https://www.zotify.app/api/spotify/callback, plus
# http://127.0.0.1:3000/api/spotify/callback for development. Without these, Spotify connections are turned off.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: a different redirect URI than the ones above
# SPOTIFY_REDIRECT_URI=
