{
  "compilerOptions": {
    // Node 22 runs ES2023 natively, as ES modules
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    // Build src/ into dist/
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,

    // Type checking
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
